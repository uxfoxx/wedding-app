{
  "name": "wedding-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "migrate": "node src/migrate.ts",
    "seed": "node src/seed.ts",
    "test": "NODE_ENV=test DATABASE_URL=postgres://wed:wed@localhost:5432/wedding_test STORAGE_DIR=/tmp/wedding-test-storage node --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1"
  }
}
